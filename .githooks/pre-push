#!/usr/bin/env bash
# Pre-push guard: block a push when metadata is invalid or the README index is
# stale relative to the metadata (the cause of the silent missing-entries drift).
# Install with: just hooks   (sets core.hooksPath to .githooks)
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

echo "pre-push: validating metadata + README + links (offline)..."
uv run scripts/validate_metadata.py
uv run scripts/generate_readme.py --check
uv run scripts/check_links.py --offline
echo "pre-push: OK"
