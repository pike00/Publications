# Configuration for the LLM-backed scripts (autotag.py, summarize.py).
# Copy to .env (gitignored) and fill in, or export these as environment vars.
# Read via pydantic-settings in scripts/llm.py; the endpoint must be
# OpenAI-compatible (e.g. a LiteLLM proxy).

# OpenAI-compatible base URL (include the /v1 path).
LITELLM_BASE_URL=http://127.0.0.1:4000/v1

# API key, required for autotag/summarize. Also accepted under OPENAI_API_KEY,
# LITELLM_GATEWAY_KEY, or AUDIT_SKILLS_PIKELLM_KEY.
LITELLM_API_KEY=

# Model id served by the endpoint.
PUBLICATIONS_MODEL=deepseek-v4-pro-cloud
