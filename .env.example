# Configuration for the LLM-backed scripts (autotag.py, summarize.py).
# Copy to .env (gitignored) and fill in, or export these as environment vars.
# Read via pydantic-settings in scripts/llm.py; the endpoint must be
# OpenAI-compatible (any /v1/chat/completions server).

# OpenAI-compatible base URL (include the /v1 path).
# Also accepted under LITELLM_BASE_URL / OPENAI_BASE_URL.
LLM_BASE_URL=http://localhost:4000/v1

# API key, required for autotag/summarize. Also accepted under LITELLM_API_KEY
# or OPENAI_API_KEY.
LLM_API_KEY=

# Model id served by the endpoint. Also accepted under PUBLICATIONS_MODEL.
LLM_MODEL=deepseek-v4-pro-cloud
